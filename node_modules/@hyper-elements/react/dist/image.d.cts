    field?: string;
    /** Its field and those of the runs drawn inside it (a Span's, a Link's). */
    fields: string[];
    type: string;
    x: number;
    y: number;
    width: number;
    height: number;
    /** A block of text's lines, from its content height over its line height. */
    lines?: number;
