    strict?: boolean;
}
interface ImageResult {
    /** The image file. */
    image: Uint8Array;
    /** Its size in pixels. */
    width: number;
    height: number;
    /** Warnings and notes (errors are thrown). */
    diagnostics: Diagnostic[];
}
/**
 * A Canvas written as an image. It's measured first with its fonts: fitted text drawn at the size that fits, and what
