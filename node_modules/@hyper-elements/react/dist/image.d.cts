    fontSize?: number;
}
interface FitResult {
    path: string;
    field?: string;
    /** The sizes in its list that fit with this text. */
    sizes: number[];
    /** The size it's drawn at: the largest that fits, or null where none does. */
    chosen: number | null;
    /** The size above the chosen one, which doesn't fit: its lines, and the word too wide for it where one is. */
    next?: {
        size: number;
        lines: number;
        widestWord?: string;
    };
}
interface GlyphResult {
    path: string;
    field?: string;
    /** The characters no given font covers. */
    text: string;
    language: string;
}
interface ImageLayout {
    width: number;
    height: number;
    scale: number;
    nodes: LaidOutNode[];
    fits: FitResult[];
    glyphs: GlyphResult[];
    diagnostics: Diagnostic[];
}

type FontFormat = "woff2" | "woff" | "truetype" | "opentype";
type FontFace = {
    family: string;
    src: string;
    format?: FontFormat;
    weight?: number | [number, number];
    style?: "normal" | "italic";
};

interface ImageFont {
    /** The family a template names in its fontFamily stacks ("Inter"). */
    family: string;
    /** The font file (TTF, OTF or WOFF; not WOFF2). */
    src: Uint8Array | ArrayBuffer;
    weight?: number;
    style?: "normal" | "italic";
}
