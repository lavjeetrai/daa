import { FragmentCapture, FieldInputs, FieldValues, Snapshot } from '@hyper-elements/react';
import React from 'react';

/**
 * The template tree: what a template's JSX is collected into inside one
 * render, and what layout and every writer read. Internal, never public; plain
 * data (no functions, no React elements).
 */
type Json = string | number | boolean | null | Json[] | {
    [key: string]: Json;
};

/**
 * What validation, resolution and conversion found: one list, each entry
 * naming the node (by id where it has one) and the path to the value.
 */
type Severity = "error" | "warning" | "info";
interface Diagnostic {
    /** Stable, for tools to match on: "prop/unknown", "layout/overflow", … */
    code: string;
    severity: Severity;
    message: string;
    /** Where in the input: `root.children[1].style.padding`. */
    path: string;
    /** The node's id, once it has one. */
    nodeId?: string;
    /** The template field the node shows (`headline`, `stories[1].image`), where it's bound to one: it or what holds it. */
    field?: string;
    /** The email clients it's about (a plugin's, such as email-clients'); absent: none in particular. */
    clients?: readonly string[];
    /** What to change. */
    fix?: string;
    /** Where to see more about it (an https URL). */
    see?: string;
}

type JsonSchema = {
    [key: string]: unknown;
};
/** Conceptual editors, mapped by each editor (the builder, others) to its own widgets. */
type EditorKind = "color" | "length" | "insets" | "border" | "radius" | "choice" | "fontFamily" | "fontFaces" | "items" | "fontWeight" | "lineHeight" | "image" | "link" | "text" | "number" | "toggle";
type Parsed<T> = {
    ok: true;
    value: T;
} | {
    ok: false;
    message: string;
};
interface Kind<In = unknown, Out extends Json = Json> {
    readonly name: string;
    readonly editor: EditorKind;
    /** What it accepts, in words (for messages and descriptions). */
    readonly accepts: string;
    parse(input: unknown): Parsed<Out>;
    /** Whether a value it parsed sets nothing (`breakpoints={{}}`): the prop is then left out, as if not given. */
    empty?(value: Out): boolean;
    jsonSchema(): JsonSchema;
    /** Type only: what it accepts as input. */
    readonly __in?: In;
}
type OutputOf<K> = K extends Kind<unknown, infer O> ? O : never;
type FontFamily = string;
/** A multiple of the font size (1.5), or a fixed height in px ("24px"). */
type LineHeight = number | `${number}px` | "normal";
/** The outputs Elements renders. */
type Target = "email" | "web" | "print" | "pdf" | "image";
/** The roots a template can have: each decides the output (`render()` writes an Email's HTML, a Page's, …). */
type RootName = "Email" | "Page" | "Document" | "Canvas";
interface PropSpec<K extends Kind<any, any> = Kind<any, any>, R extends boolean = boolean> {
    kind: K;
    required?: R;
    label: string;
    description?: string;
    /**
     * How to fill it well, in plain English, for whoever (or whatever agent) gives its value: never enforced, only shown
     * (`describeComponents()`, a template's `describe()` and its `check()`'s review items). `description` says what it is.
     */
    guidance?: string;
    /**
     * The roots it may be given under (default: every root its component goes in). Under another root it's a
     * `prop/not-supported` error naming these.
     */
    roots?: readonly RootName[];
    /** Used where the prop isn't given (not written into the document). */
    default?: OutputOf<K>;
    /** Editors may change it (default true). */
    editable?: boolean;
    /** How each output shows it: required for every output its component renders to (a test checks). */
    support?: SupportByTarget;
}
/** A style's or prop's support, by output. */
type SupportByTarget = Partial<Record<Target, Support | readonly Support[]>>;
/**
 * Where what an output shows of a style or prop is known from: the output's writer itself, which turns it into markup
 * the output shows (checked in Chromium, for email with and without <style>); CSS written as is, which browsers show as
 * asked; or assumed, not yet checked. What email clients do with the HTML isn't declared here: it's the email-clients
 * plugin's (plan email-client-models, D9).
 */
type SupportSource = "writer" | "css" | "assumed";
/**
 * How an output shows a style or prop, or some of its values (`values`, or
 * `when` the value, on a node with such props, is such): as asked (`full`);
 * not quite as asked (`partial`: what it shows); or not at all (`none`: what it
 * does instead). Read by the support pass every output runs: `partial` is a
 * note, `none` a warning; one `assumed` is only ever a note.
 */
type Support = {
    level: "full";
    source: SupportSource;
} | {
    level: "partial" | "none";
    shows: string;
    values?: readonly Json[];
    when?: (value: Json, node: {
        props: Record<string, Json>;
        style?: Record<string, Json>;
        mobile?: Record<string, Json>;
    }) => boolean;
    source: SupportSource;
    /** What to change. */
    fix?: string;
};
type PropSpecs = Record<string, PropSpec>;

/**
 * Resolving a document: what every target needs worked out the same way
 * before it writes anything. Defaults applied, text styles inherited, and
 * every box's width on desktop in px, from the root's width down. Targets
 * only turn this into markup; none of them decides layout on its own.
 */

/** Text styles as they apply to a node: its own, its component's defaults, else its parent's. */
interface ResolvedText {
    color: string;
    fontFamily: FontFamily;
    fontSize: number;
    fontWeight: number;
    fontStyle: "normal" | "italic";
    lineHeight: LineHeight;
    /** The line height in px at this node's font size. */
    lineHeightPx: number;
    letterSpacing: number;
    textAlign: "left" | "center" | "right" | "justify";
    textTransform: "none" | "uppercase" | "lowercase" | "capitalize";
}

/** The version of this contract; a plugin can check the core it runs on. */
declare const PLUGIN_API = 1;
/** A laid-out node's data, copied: JSON values only, with its component's defaults (what an author didn't set). */
interface PluginNode {
    id?: string;
    /** Its place in the tree as laid out (`root.children[2]`); `PluginInput.templatePath` gives the template's. */
    path: string;
    type: string;
    props: Record<string, Json>;
    /** Its style, its component's defaults under its own. */
    style: Record<string, Json>;
    hover?: Record<string, Json>;
    mobile?: Record<string, Json>;
    hidden?: {
        mobile?: boolean;
        desktop?: boolean;
    };
    text: ResolvedText;
    available: number | null;
    width: number | null;
    contentWidth: number | null;
    columns?: number[] | null;
    columnSizes?: Array<"px" | "share" | "free"> | null;
    children: ReadonlyArray<PluginNode | string>;
    /** Its component's defaults: props, style, and style by a prop's value. */
    defaults: {
        props: Record<string, Json>;
        style: Record<string, Json>;
        styleBy?: {
            prop: string;
            values: Record<string, Record<string, Json>>;
        };
    };
}
interface PluginInput {
    /** A deeply frozen copy of the laid-out tree. */
    root: PluginNode;
    /** A laid-out path as the template's (inside a Grid, a custom component). */
    templatePath(path: string): string;
    /** Whether a template path is inside a built-in component's expansion (a Menu's separators). */
    builtIn(templatePath: string): boolean;
    /** Core's estimates, on its own tree, by laid-out path: a Row's content on one line, and how far that runs past it. */
    estimate: {
        oneLineWidth(path: string, phone?: number): number;
        wrapsPastIts(path: string): number | null;
    };
}
/** The written output, compact (before `pretty`): `stylesheet` is the `<style>` text an Email's writer wrote ("" otherwise). */
interface PluginOutput {
    /** The root's type (`Email`, `Page`, `Document`, `Canvas`): which output this is. */
    root: string;
    html: string;
    head: string;
    body: string;
    stylesheet: string;
}
interface PluginDiagnostic {
    code: string;
    severity: "info" | "warning";
    message: string;
    path: string;
    nodeId?: string;
    clients?: readonly string[];
    fix?: string;
    see?: string;
}
interface ElementsPlugin {
    /** Unique among the plugins passed. */
    name: string;
    api: typeof PLUGIN_API;
    check?(input: PluginInput): readonly PluginDiagnostic[];
    checkOutput?(output: PluginOutput): readonly PluginDiagnostic[];
}

/**
 * Rules over the result, which fail closed. A template requires lint rules and core codes, limits its links and
 * requires root props; each required rule ends `passed`, `failed` or `not-run`, and one that didn't run never counts as
 * passed. What can be refused when the template is defined is refused then (`template/rule-unavailable`).
 */

/** What lint's plugin says of each rule (lint 0.2): `lint().rules`. */
interface LintRuleDescriptor {
    readonly id: string;
    readonly roots: readonly string[];
    readonly enabled: boolean;
    readonly summary: string;
    readonly fix: string;
}
interface LinkRules {
    /** The hosts an http(s) link may go to: `acme.com`, or `*.acme.com` for its subdomains. */
    domains?: readonly string[];
    /** Query parameters every http(s) link carries, with their values. */
    params?: Readonly<Record<string, string>>;
    /** Schemes besides http(s) a link may use (`mailto`, `tel`). */
    schemes?: readonly string[];
    /** A sending service's tag in a URL (`{{…}}`): listed for review (`"allow"`, the default) or refused (`"deny"`). */
    tags?: "allow" | "deny";
}
interface TemplateRules {
    plugins?: {
        lint?: ElementsPlugin;
        other?: readonly ElementsPlugin[];
    };
    require?: {
        lint?: readonly string[];
        core?: readonly string[];
    };
    links?: LinkRules;
    /** Root props a design must set: `{ lang: true, previewText: true }`. */
    root?: Readonly<Record<string, true>>;
}
/** A required rule's result in one format. */
interface RuleResult {
    rule: string;
    source: "lint" | "core" | "template";
    format?: string;
    status: "passed" | "failed" | "not-run";
    diagnostics: Diagnostic[];
}
/** The core codes a template can require: the stage that decides each and the roots it runs for. */
declare const CORE_RULES: Readonly<Record<string, {
    stage: "read" | "measured";
    roots: readonly RootName[];
}>>;

/**
 * A simple template written as an annotated design (Decision 32): the design an author would write anyway, with what's
 * open marked where it is. `open(spec)` makes a marker for one field, `open: { title, body }` names them, and each
 * marker goes on a built-in written in `design` itself as its `field`:
 *
 *   const title = open(prop.text({ label: "Title", required: true, maxLength: 70 }));
 *   template({ id, version, open: { title }, design: <Email><Heading field={title}>What's new</Heading></Email> });
 *
 * When the template is defined, the design is walked once: each marker's node opens its text (a text field), its
 * href (a link), its src (an image field) or its children (a slot); what it holds is the example; and the render
 * rebuilds the tree with each value in its place.
 */

/** A marker for one open field: put it on a built-in in `design` as its `field`. */
interface Open<S extends PropSpec = PropSpec> {
    readonly spec: S;
}
/** A marker for one field of an annotated template: its spec, which `open: { name }` names. */
declare function open<const S extends PropSpec>(spec: S): Open<S> & string;
interface AnnotatedSpec<F extends PropSpecs = PropSpecs> {
    id: string;
    version: string;
    label?: string;
    description?: string;
    guidance?: string;
    rules?: TemplateRules;
    migrate?: Record<number, (values: Record<string, unknown>) => unknown>;
    /** The markers by field name: what the template's props are, and their types. */
    open: {
        [K in keyof F]: Open<F[K]>;
    };
    /** The design, with each marker on the built-in that shows its field. */
    design: React.ReactElement;
}

/**
 * Slots: JSX the filler writes, inside limits the template sets. A slot's content is collected on its own and
 * spliced in at its mark (Decision 29's snapshot), and its preflight runs on the captured content before anything is
 * read or expanded: which elements it may use (built-ins by type, a custom element by its definition, never its
 * name), how it may be styled (`"none"`, `"theme"` or `"free"`), how many of each (`count`), and no `attrs`, scopes
 * or bindings of its own.
 */

/** How a slot's content may be styled: only the theme's named styles and variants, every brand value a token, or anything. */
type SlotStyles = "none" | "theme" | "free";
/** An element a slot allows: a built-in (`Text`) or a custom element, given as the element itself. */
type SlotComponent = React.ComponentType<any>;
interface SlotOptions<R extends boolean> {
    label: string;
    required?: R;
    description?: string;
    guidance?: string;
    /** The elements its content may use, or `"all"` (every built-in its root takes but the roots and Html), with custom elements beside it. */
    allow: "all" | ReadonlyArray<SlotComponent | "all">;
    /** With `"all"`: built-ins it leaves out. */
    deny?: readonly SlotComponent[];
    /** How its content may be styled (default `"theme"`). */
    styles?: SlotStyles;
    /** How many of a type its content may hold, by type name: `{ Button: { min: 1, max: 2 } }`. */
    count?: Record<string, {
        min?: number;
        max?: number;
    }>;
}
/** A slot as it's stored: its content's module, or its content captured (Decision 24). */
type StoredSlot = {
    module: string;
} | {
    fragment: FragmentCapture;
};
/** What a slot's spec holds besides a prop spec's. */
interface SlotRules {
    allow: ReadonlyArray<SlotComponent | "all">;
    deny: readonly SlotComponent[];
    styles: SlotStyles;
    count: Readonly<Record<string, {
        min?: number;
        max?: number;
    }>>;
}
/** A slot's spec: what a template's fields hold for one. Its value is the content: a React element. */
type SlotSpec<R extends boolean = boolean> = PropSpec<Kind<React.ReactElement, never>, R> & {
    default: undefined;
    slot: SlotRules;
};
declare function slot<const R extends boolean = false>(options: SlotOptions<R>): SlotSpec<R>;

/**
 * What a template's check finds once its design is built: the design's own problems (`validate()`), and what only the
 * template knows, read from the design laid out (`prepare()`): its root and its format's size, its bindings (a node's
 * `field` that names no field, an image with rules that nothing shows), and how each bound image is shown (distorted,
 * or cropped past what its rules allow). These catch a template's own mistakes, not only bad values.
 */

/** A format: a Canvas's size (and its pixels per px), or a Document's page. */
interface Format {
    width?: number;
    height?: number;
    scale?: number;
    size?: "A3" | "A4" | "A5" | "Letter" | "Legal" | "Tabloid";
    orientation?: "portrait" | "landscape";
}

/**
 * A template's fields: the `prop` helpers' specs (text, date, list, object, …) and `field.image()`, an image spec with
 * the rules only a template checks. Specs compose: a list keeps its `item`, an object its `fields`, so a rule inside a
 * list of objects (`stories[1].image`) is read wherever it is.
 */

/** An image field's value: its file's URL or path, and the file's size in px (what its rules are checked against). */
interface ImageValue {
    src: string;
    width: number;
    height: number;
}
/** The image types a rule can name. */
type ImageType = "png" | "jpeg" | "gif" | "svg" | "webp";
/** What a template asks of an image: checked against its declared size, its file, and where it's drawn. */
interface ImageRules {
    /** `contain`: shown whole, at its own aspect. `cover`: fills its region, cropped from the center. */
    fit?: "contain" | "cover";
    /** Its width over its height, at least `min` and at most `max`. */
    aspect?: {
        min?: number;
        max?: number;
    };
    minWidth?: number;
    minHeight?: number;
    accepts?: readonly ImageType[];
    transparent?: "required" | "forbidden";
    /** A `cover` image's most cut from either side, as a share of its width or height (0.6: 60%). */
    maxCrop?: number;
}
type ImageOptions<R extends boolean> = Omit<PropSpec<Kind<any, any>, R>, "kind" | "default"> & ImageRules;
/** An image field's spec: `prop.image()`'s, with its rules beside it (data the core kind never sees). */
type ImageSpec<R extends boolean = boolean> = PropSpec<Kind<ImageValue, ImageValue & Json>, R> & {
    default: undefined;
    image: ImageRules;
};
/** Fields only a template checks. */
declare const field: {
    /**
     * JSX the filler writes, inside limits the template sets: the components it may use (`allow`, or `"all"` less
     * `deny`), how it may be styled (`styles`), and how many of each (`count`). The template places it inside a built-in
     * bound to it: `<Section field="body">{v.body}</Section>`.
     */
    slot: typeof slot;
    /**
     * An image, given as `{ src, width, height }` (the file's size in px), with the rules a template checks: against
     * the size given, the file (the CLI, `checkLayout()`), and where the template draws it (bound with `field`).
     */
    image<const R extends boolean = false>(options: ImageOptions<R>): ImageSpec<R>;
};

/** The shape of what `describe()` returns: a new version is a new shape. */
declare const DESCRIBE_VERSION = 1;
interface FieldDescription extends Omit<ImageRules, "fit"> {
    /** Its path (`headline`); a list's items and an object's fields too (`stories[].image`). */
    path: string;
    /** "text", "list", "object", "date", "choice", "image", "link", "number", … */
    kind: string;
    label: string;
    description?: string;
    guidance?: string;
    required: boolean;
    default?: unknown;
    schema: JsonSchema;
    /** An image the template shows: its box in each format, and the pixels that box needs at the format's scale. */
    regions?: Record<string, {
        box: [number, number];
        pixels: [number, number];
    } | "measured by check">;
    /**
     * An image's fit (`"contain"`, `"cover"`); or, for text a Canvas fits, by format, the sizes it may be drawn at and the
     * lines it may take, from its bound node's fit.
     */
    fit?: "contain" | "cover" | Record<string, {
        sizes?: number[];
        maxLines?: number;
    }>;
    /** A cover image: the smallest size that fills every format's region without upscaling, and what each crops. */
    suggested?: {
        width: number;
        height: number;
        crop: Record<string, string>;
    };
    /** A field of a block type (`body[].image`): that block's type. */
    block?: string;
    /** A slot: the components its content may use, by type (`"all"`, with what it denies and the set it resolves to). */
    allow?: string[] | "all";
    deny?: string[];
    allowed?: string[];
    styles?: "none" | "theme" | "free";
    count?: Record<string, {
        min?: number;
        max?: number;
    }>;
}
/** The rules a template requires, as whoever fills it reads them before starting. */
interface RulesDescription {
    lint: Array<{
        id: string;
        summary: string;
        fix: string;
    }>;
    core: Array<{
        code: string;
        stage: "read" | "measured";
    }>;
    links?: TemplateRules["links"];
    root?: string[];
}
interface TemplateDescription {
    version: typeof DESCRIBE_VERSION;
    id: string;
    templateVersion: string;
    label: string;
    description?: string;
    root: RootName;
    guidance?: string;
    formats?: Record<string, Format>;
    fields: FieldDescription[];
    rules: RulesDescription;
    /** The theme's tokens by group, which slot content uses (`token("colors.primary")`), as inspect() lists them. */
    theme: unknown;
    /** A JSON Schema of the values. */
    valuesSchema: JsonSchema;
    /** What's fixed: everything not a field. */
    fixed: string;
}

/**
 * Images, by arithmetic and by their bytes: the size that keeps an image's aspect inside a box (`fitInside()`), and
 * an image file's size, type and transparency read from its header (`sniffImage()`), in plain JavaScript with no Node
 * API, so it runs wherever a template does.
 */

/**
 * The size an image is shown at to fit whole inside `box`, at its own aspect: for a `contain` image's `style`, so a
 * template doesn't do the arithmetic (and its check finds it neither cropped nor distorted).
 */
declare function fitInside(image: {
    width: number;
    height: number;
}, box: {
    width: number;
    height: number;
}): {
    width: number;
    height: number;
};
/** What an image file's header says: its size in px, its type, and whether it can be transparent. */
interface SniffedImage {
    width: number;
    height: number;
    type: ImageType;
    /** It has an alpha channel or a transparent color (an SVG is always taken as able to be transparent). */
    alpha: boolean;
}
/** A PNG, JPEG, GIF or SVG file's size, type and transparency, from its header; undefined for anything else. */
declare function sniffImage(input: Uint8Array | ArrayBuffer): SniffedImage | undefined;
/** The part of `layoutImage()`'s result `checkLayout()` reads. */
interface MeasuredLayout {
    nodes: ReadonlyArray<{
        path: string;
        field?: string;
        type: string;
        width: number;
        height: number;
    }>;
    fits: ReadonlyArray<{
        path: string;
        field?: string;
        sizes: number[];
        chosen: number | null;
        next?: {
            size: number;
            lines: number;
            widestWord?: string;
        };
    }>;
    diagnostics: readonly Diagnostic[];
}
/** What `checkLayout()` takes beside a template and its values. */
interface CheckLayoutOptions {
    format?: string;
    /** Pixels per px, as it's rendered: the format's, or the caller's. */
    scale?: number;
    /** `layoutImage()`'s result for the format's snapshot. */
    layout: MeasuredLayout;
    /** Each image field's file, sniffed (`sniffImage()`), by its field path. */
    files?: Record<string, SniffedImage>;
    /** `check()`'s result, whose measured rules this decides. */
    checked?: {
        rules: readonly RuleResult[];
    };
}
/** What `checkLayout()` returns: each region's box and pixels, the fitted text by field, the rules complete, and what it found. */
interface LayoutCheck {
    regions: Record<string, Record<string, {
        box: [number, number];
        pixels: [number, number];
    }>>;
    fits: MeasuredLayout["fits"];
    rules: RuleResult[];
    diagnostics: Diagnostic[];
}
/**
 * A template's checks on a measured layout (`layoutImage()` of its snapshot): each image's region and the pixels it
 * needs at the scale it's rendered, its file against its rules and its declared size, and the measured rules the
 * template requires decided. Synchronous and pure: the caller measures, and sniffs the files.
 */
declare function checkLayout(template: {
    id: string;
    fields: PropSpecs;
    formats?: Record<string, {
        scale?: number;
    }>;
}, values: unknown, options: CheckLayoutOptions): LayoutCheck;

/**
 * `@hyper-elements/react/template`: templates, reusable designs with guardrails. A template holds the parts of a design
 * that never change, opens fields (typed values, each with its rules) for whoever fills it, and checks the result:
 *
 *   const Launch = template({ id: "acme.Launch", version: "1.0.0", label: "Launch", root: "Canvas", fields, example, render });
 *   export default () => <Launch headline="Orbit is live" … />;    // a design: render() checks it, then renders it
 *   Launch.check(values);                                           // { valid, values, diagnostics, review, … }
 *
 * It imports the main entry by name (left external, as /pdf and /image do), and no engine, Node API or code that
 * evaluates strings: it runs wherever a design does.
 */

/** A template's format names, or `undefined` for a template with one size. */
type FormatName<Fm> = [keyof Fm] extends [never] ? undefined : keyof Fm & string;
interface TemplateSpec<F extends PropSpecs, Fm extends Record<string, Format>> {
    /** A namespace, a dot and a capitalized name, as a component's type: "acme.LaunchGraphic". */
    id: string;
    /** Its version, semver ("1.0.0"): a design's values file records it, and a newer major needs a migration. */
    version: string;
    label: string;
    description?: string;
    /** How to fill it well, for the whole design: plain English, never enforced (`check()` lists it for review). */
    guidance?: string;
    /** The root its render returns. */
    root: RootName;
    /** Its named sizes: a Canvas's `{ width, height, scale }`, a Document's `{ size, orientation }`. None: one size. */
    formats?: Fm;
    /** Its open parts: `prop` helpers' specs and `field.image()`. */
    fields: F;
    /** Values it's shown and tested with: `describe()` lays them out, and `check()` must accept them. */
    example: FieldInputs<F>;
    /** By major version: a values file of that major's values, as this version takes them. */
    migrate?: Record<number, (values: Record<string, unknown>) => unknown>;
    /** Rules over the result: lint rules and core codes required, links and root props (Decision 25). */
    rules?: TemplateRules;
    /** The design for some checked values, in a format: the template's whole root (nothing beside it reaches the output). */
    render(values: FieldValues<F>, context: {
        format: FormatName<Fm>;
    }): React.ReactElement;
}
/** What `check()` returns: never thrown. */
interface CheckResult<F extends PropSpecs = PropSpecs, Fm extends Record<string, Format> = Record<string, Format>> {
    /** No errors in the values or in any format's design (there may be warnings and notes). */
    valid: boolean;
    /** The values read: defaults filled in, a list not given `[]`. Absent where they couldn't be read. */
    values?: FieldValues<F>;
    diagnostics: Diagnostic[];
    /** Each required rule's result, by format (Phase 1b: rules). */
    rules: RuleResult[];
    /** What a reviewer checks by eye: each field's guidance and the template's, as it was asked. Never changes `valid`. */
    review: Array<{
        field?: string;
        template?: string;
        guidance: string;
    }>;
